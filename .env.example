# ──────────────────────────────────────────────────────────────
# AI 社媒矩阵运营系统 — 环境变量模板
# 复制为 .env 后填入实际值；生产环境所有 ⚠️ 项必须修改
# ──────────────────────────────────────────────────────────────

# ── 运行环境 ──
APP_ENV=development                    # development|production（生产必须为 production）
# ⚠️ 生产必须修改：长度≥32 的随机字符串，可用 `openssl rand -hex 32` 生成
APP_SECRET_KEY=change-me-in-production
APP_DEBUG=false

# ── 服务端口（scripts/start-local.sh 会在占用时自动选择其它端口）──
COMPOSE_PROJECT_NAME=ai-social-media
# Web 入口监听全部网卡；数据库、Redis、MinIO 等调试端口仍只绑定 127.0.0.1。
APP_BIND_HOST=0.0.0.0
# 局域网客户端使用的 Mac 服务器地址，仅用于启动提示和文档。
APP_ACCESS_HOST=192.168.1.10
SYNAPSE_LOGIN_BROWSER_MODE=native_host
SYNAPSE_PUBLISH_BROWSER_MODE=native_host
SYNAPSE_NATIVE_BROWSER_SHARED_MEDIA_DIR=/tmp/ai-social-native-media
NATIVE_BROWSER_BRIDGE_PORT=9324
SYNAPSE_NATIVE_BROWSER_MANAGER_TOKEN=ai-social-native-bridge-local
HOST_BROWSER_BRIDGE_TOKEN=ai-social-native-bridge-local
APP_HTTP_PORT=8080
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=5174
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6380
MINIO_HOST_PORT=9002
MINIO_CONSOLE_HOST_PORT=9003
# Vite 本地 dev server 可用 FRONTEND_DEV_PORT 覆盖；API 代理默认指向当前本地后端。
# VITE_API_TARGET=http://127.0.0.1:8002

# ── 数据库 ──
# ⚠️ 生产必须修改密码
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_social_media
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_social_media

# ── Redis ──
REDIS_URL=redis://redis:6379/0
# 生产必填（≥16位），并同步写入 REDIS_URL。本地开发留空。
REDIS_PASSWORD=

# ── MinIO 对象存储 ──
# ⚠️ 生产必须修改 access key / secret key
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=assets
MINIO_SECURE=false

# ── CORS 白名单（逗号分隔，生产必须改为具体域名；只有 APP_ENV=development 可临时使用 *）──
CORS_ORIGINS=http://127.0.0.1:30001,http://127.0.0.1:5176
ALLOWED_HOSTS=*
HEALTHCHECK_HOST=health.internal

# ── AI 模型（上线禁止 mock；未配置密钥时接口会明确报错）──
AI_MOCK_MODE=false
LLM_PROVIDER=database                  # database|deepseek|qwen；database 使用模型配置页面
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=120
# 默认禁止模型地址访问本机/内网；仅接入可信内网模型服务时才改为 true。
LLM_ALLOW_PRIVATE_BASE_URL=false
# 使用 Clash/Surge fake-IP DNS（198.18.0.0/15）时按需开启；不会放行其它内网地址
LLM_ALLOW_FAKE_IP_DNS=false

# ── 外部服务 Provider ──
# 自动发布统一走 Synapse Playwright；指标由数据库中的真实采集结果聚合。
SOCIAL_PROVIDER=synapse_embedded
ANALYTICS_PROVIDER=database
NOTIFY_PROVIDER=disabled               # disabled|wecom|email
EMBEDDING_PROVIDER=disabled            # disabled|openai
MAP_PROVIDER=disabled                  # disabled|amap|tencent
# MOCK_SCENARIO 仅供自动化测试显式开启 AI_MOCK_MODE 后使用。
MOCK_SCENARIO=normal

# ── 企微通知（NOTIFY_PROVIDER=wecom 时必填）──
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# ── OpenAI 向量嵌入（EMBEDDING_PROVIDER=openai 时必填）──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── 地图服务（MAP_PROVIDER=amap/tencent 时必填）──
AMAP_KEY=                                  # 高德地图 Web 服务 Key
TENCENT_MAP_KEY=                           # 腾讯位置服务 Key

# ── 社媒平台 API base（access_token 从 DB Account 表读取，OAuth 授权后存入）──
# DOUYIN_OPEN_BASE_URL=https://open.douyin.com
# XIAOHONGSHU_OPEN_BASE_URL=https://edith.xiaohongshu.com
# WECHAT_MP_BASE_URL=https://api.weixin.qq.com
# WECHAT_VIDEO_BASE_URL=https://api.weixin.qq.com

# ── 小红书说明 ──
# 小红书官方开放平台已暂停接入，采用「AI 助手浏览器自动化」模式发布：
# 后端生成发布包 → AI 助手用 browser-use skill 操作浏览器发布 → 回填 note_id
# 无需额外凭证配置，只需 AI 助手环境安装 browser-use skill

# ── 邮件通知（NOTIFY_PROVIDER=email 时必填，可选）──
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ── Elasticsearch（可选，代码未接入）──
ES_URL=http://elasticsearch:9200

# ── JWT ──
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── 电话加密 ──
# ⚠️ 生产必须修改：长度≥32 的随机字符串
PHONE_ENCRYPTION_KEY=phone-encryption-key-32bytes!!
COOKIE_ENCRYPTION_KEY=cookie-encryption-key-change-me

# ── 初始管理员（不会创建任何演示业务数据）──
# ⚠️ 生产必须修改（否则 APP_ENV=production 启动时校验拦截）；长度≥8
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=系统管理员
SEED_ADMIN_PASSWORD=admin123

# Celery 浏览器任务并发；每个任务可能启动 Chromium，不建议按 CPU 数量自动放大。
# 队列隔离：通用任务可并行，发布固定单并发避免浏览器/外部写入互相干扰。
CELERY_DEFAULT_CONCURRENCY=2
CELERY_PUBLISH_CONCURRENCY=1
CELERY_CRAWL_CONCURRENCY=1
BACKUP_RETAIN_DAYS=7
SCREENSHOT_RETAIN_DAYS=7
NATIVE_MEDIA_RETAIN_DAYS=2

# ── Synapse 内嵌发布引擎（浏览器自动化发布）──
SYNAPSE_EMBEDDED_ENABLED=true
SYNAPSE_PLAYWRIGHT_HEADLESS=true
SYNAPSE_PLAYWRIGHT_RUNTIME=patchright  # patchright|playwright
SYNAPSE_STORAGE_DIR=data/synapse       # cookie / 截图留痕根目录
SYNAPSE_COOKIE_DIR=data/synapse/cookies
# SYNAPSE_LOCAL_CHROME_PATH=           # 留空使用 Playwright 自带 chromium
SYNAPSE_ALLOW_LOCAL_MEDIA=false       # 生产保持 false，防止任务读取宿主机任意路径

# ── MediaCrawler 内嵌采集引擎 ──
MEDIACRAWLER_EMBEDDED_ENABLED=true
MEDIACRAWLER_DATA_DIR=data/mediacrawler
MEDIACRAWLER_HEADLESS=true
MEDIACRAWLER_MAX_NOTES_COUNT=20
CRAWLER_PARSE_MAX_SIZE=104857600       # 单个采集文件最大解析大小（100MB）
CRAWLER_PARSE_MAX_ITEMS=10000          # 单文件最多解析条数，防止异常文件耗尽内存
CRAWLER_PROVIDER=mediacrawler_embedded # mock|mediacrawler_embedded

# ── 上传限制 ──
UPLOAD_MAX_SIZE=52428800               # 50MB，单位字节
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/gif,video/mp4,application/pdf
